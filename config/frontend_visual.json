{
  "schema_version": 1,
  "colors": {
    "brand_yellow": "#FEC60D",
    "brand_light_blue": "#0176DE",
    "brand_blue": "#173F8A",
    "semantic_success": "#00AA00",
    "semantic_error": "#F24F4F",
    "neutral_gray_500": "#9C9C9C",
    "neutral_gray_700": "#707070",
    "neutral_black": "#000000",
    "neutral_gray_50": "#F6F6F6",
    "neutral_gray_100": "#F0F0F0",
    "neutral_white": "#FFFFFF",
    "neutral_gray_300": "#C6C6C6",
    "neutral_gray_200": "#EAEAEA"
  },
  "typography": {
    "preferred_family": "Roboto",
    "fallback_families": [
      "Noto Sans",
      "Sans Serif"
    ],
    "sizes": {
      "caption": 12,
      "body": 16,
      "button": 18,
      "subtitle": 24,
      "title": 36
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "screens": {
    "login": {
      "width": 768,
      "height": 768
    },
    "register": {
      "width": 768,
      "height": 768
    },
    "menu": {
      "width": 768,
      "height": 768
    },
    "academic_list": {
      "width": 1080,
      "height": 768
    },
    "academic_form": {
      "width": 1080,
      "height": 768
    },
    "assignment_flow": {
      "width": 1080,
      "height": 820
    }
  },
  "margins": {
    "page": 48,
    "section": 32
  },
  "spacing": {
    "extra_small": 4,
    "small": 8,
    "medium": 16,
    "large": 24,
    "extra_large": 32
  },
  "radii": {
    "small": 4
  },
  "borders": {
    "control": {
      "width": 1,
      "color_token": "neutral_gray_300"
    },
    "focus": {
      "width": 2,
      "color_token": "brand_light_blue"
    }
  },
  "shadows": {
